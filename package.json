{
  "name": "smart-expense-tracker",
  "private": true,
  "version": "1.1.5",
  "description": "智慧記帳 - AI & 投資理財助手 (支援 Windows .exe / Android .apk / PWA 單一視窗與自動版本更新)",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "electron:start": "npx electron .",
    "build:win": "npm run build && npx --yes electron-builder --win --config electron-builder.json --publish never",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "date-fns": "^4.1.0",
    "firebase": "^11.3.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5",
    "recharts": "^2.15.1",
    "uuid": "^11.1.0",
    "vaul": "^1.1.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "gh-pages": "^6.3.0",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^5.0.3"
  }
}
